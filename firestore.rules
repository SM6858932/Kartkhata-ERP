
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

// ============================================================
    // CUSTOM CLAIMS-BASED AUTH (Plan Section 10)
    // Custom claims are the real security boundary — set server-side
    // by admin API / Cloud Functions, never from the client.
    // ============================================================

    function isSuperAdmin() {
      return isAuthenticated() &&
        request.auth.token.role in ['admin', 'super_admin'];
    }

    function isCollector() {
      return isAuthenticated() &&
        request.auth.token.role in ['collector', 'staff'];
    }

    function isCompanyMember(companyId) {
      return isAuthenticated() &&
        request.auth.token.companyId == companyId;
    }

    function isCompanyAdmin(companyId) {
      return isCompanyMember(companyId) &&
        request.auth.token.role in ['admin', 'super_admin', 'company_admin'];
    }

    function isAssignedToVendor(vendorId) {
      return isCollector() &&
        request.auth.token.assignedToVendorIds != null &&
        vendorId in request.auth.token.assignedToVendorIds;
    }

    function onlyLocationFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['currentLat', 'currentLng', 'lastLocationAddress', 'lastLocationUpdateAt']);
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin());
      allow create: if isSuperAdmin();
      allow update: if (request.auth.uid == userId &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'phone', 'email', 'avatar', 'password'])
        ) || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    match /vendors/{vendorId} {
      allow read: if isSuperAdmin() || isAssignedToVendor(vendorId);
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin() ||
        (isCollector() && isAssignedToVendor(vendorId) && onlyLocationFields());
      allow delete: if isSuperAdmin();
    }

match /carts/{cartId} {
      allow read: if isSuperAdmin() || isCollector();
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin() || (isCollector() && onlyLocationFields());
      allow delete: if isSuperAdmin();

      // v2: locationHistory — appended automatically by Cloud Function on cart location updates
      match /locationHistory/{entryId} {
        allow read: if isSuperAdmin() || isCollector();
        allow write: if false; // Cloud Functions only
      }
    }

    match /agreements/{agreementId} {
      allow read: if isSuperAdmin() || isAssignedToVendor(resource.data.vendorId);
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin() || (
        isCollector() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['carriedBalance']) &&
        isAssignedToVendor(resource.data.vendorId)
      );
      allow delete: if isSuperAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isSuperAdmin() || isAssignedToVendor(resource.data.vendorId);
      allow create: if isSuperAdmin() || isAssignedToVendor(request.resource.data.vendorId);
      allow update: if isSuperAdmin() || (
        isCollector() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['receiptSent'])
      );
      allow delete: if isSuperAdmin();
    }

match /counters/{counterId} {
      allow read, write: if false; // Cloud Functions only — never client-writable
    }

    match /auditLogs/{logId} {
      allow read: if isAuthenticated();
      allow write: if false; // Cloud Functions only — immutable append-only ledger
    }

    match /notifications/{notifId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isSuperAdmin() || (
        isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
      );
      allow delete: if isSuperAdmin();
    }

    match /zones/{zoneId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /partnerLeads/{leadId} {
      allow read: if isSuperAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isSuperAdmin();
    }

    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /companies/{companyId} {
      allow read: if isCompanyMember(companyId) || isSuperAdmin();
      allow write: if isSuperAdmin();

      match /vendors/{vendorId} {
        allow read: if isCompanyMember(companyId) || isSuperAdmin();
        allow create: if isCompanyAdmin(companyId) || isSuperAdmin();
        allow update: if isCompanyAdmin(companyId) || isSuperAdmin() || (
          isCollector() && isCompanyMember(companyId) &&
          vendorId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.assignedVendorIds &&
          onlyLocationFields()
        );
        allow delete: if isCompanyAdmin(companyId) || isSuperAdmin();
      }

      match /carts/{cartId} {
        allow read: if isCompanyMember(companyId) || isSuperAdmin();
        allow create: if isCompanyAdmin(companyId) || isSuperAdmin();
        allow update: if isCompanyAdmin(companyId) || isSuperAdmin() || (
          isCollector() && isCompanyMember(companyId) && onlyLocationFields()
        );
        allow delete: if isCompanyAdmin(companyId) || isSuperAdmin();
      }

      match /agreements/{agreementId} {
        allow read: if isCompanyMember(companyId) || isSuperAdmin();
        allow create: if isCompanyAdmin(companyId) || isSuperAdmin();
        allow update: if isCompanyAdmin(companyId) || isSuperAdmin() || (
          isCollector() && isCompanyMember(companyId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['carriedBalance']) &&
          resource.data.vendorId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.assignedVendorIds
        );
        allow delete: if isCompanyAdmin(companyId) || isSuperAdmin();
      }

      match /payments/{paymentId} {
        allow read: if isCompanyMember(companyId) || isSuperAdmin();
        allow create: if isCompanyAdmin(companyId) || isSuperAdmin() || (
          isCollector() && isCompanyMember(companyId) &&
          request.resource.data.vendorId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.assignedVendorIds
        );
        allow update: if isCompanyAdmin(companyId) || isSuperAdmin() || (
          isCollector() && isCompanyMember(companyId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['receiptSent'])
        );
        allow delete: if isCompanyAdmin(companyId) || isSuperAdmin();
      }

      match /counters/{counterId} {
        allow read, write: if isCompanyMember(companyId) || isSuperAdmin();
      }

      match /auditLogs/{logId} {
        allow read: if isCompanyMember(companyId) || isSuperAdmin();
        allow create: if isCompanyMember(companyId) || isSuperAdmin();
        allow update, delete: if false;
      }

      match /notifications/{notifId} {
        allow read: if isCompanyMember(companyId) || isSuperAdmin();
        allow create: if isCompanyMember(companyId) || isSuperAdmin();
        allow update: if isCompanyAdmin(companyId) || isSuperAdmin() || (
          isAuthenticated() && isCompanyMember(companyId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        );
        allow delete: if isCompanyAdmin(companyId) || isSuperAdmin();
      }

      match /zones/{zoneId} {
        allow read: if isCompanyMember(companyId) || isSuperAdmin();
        allow write: if isCompanyAdmin(companyId) || isSuperAdmin();
      }
    }
  }
}
