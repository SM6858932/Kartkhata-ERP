# Firebase Config (from Firebase Console > Project Settings)
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=foodcart-khata.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=foodcart-khata
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=foodcart-khata.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=107000967755
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Firebase Admin SDK (from Firebase Console > Project Settings > Service Accounts)
# Generate a new private key, copy the JSON, and paste it as base64:
# PowerShell: [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes((Get-Content firebase-key.json -Raw)))
FIREBASE_SERVICE_ACCOUNT_KEY=base64_encoded_service_account_json

# OR use individual fields:
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@foodcart-khata.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
